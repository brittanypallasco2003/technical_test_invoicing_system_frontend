# ---------------------------------------------------------------------------
# API (backend NestJS)
# ---------------------------------------------------------------------------
# URL base de la API, sin barra final. El servidor de Next la llama directo y el
# navegador pasa por el proxy /api/* que next.config.ts reescribe hacia ella.
# Se lee al arrancar `yarn dev` y al compilar con `yarn build`: si cambia, hay
# que reiniciar o recompilar.
NEXT_PUBLIC_API_URL=http://localhost:3000
